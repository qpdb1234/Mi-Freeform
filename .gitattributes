# Line-ending policy: always store LF in the repository, so gradlew isn't left unexecutable on Linux/macOS due to CRLF
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf

# Source and text
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.aidl text eol=lf
*.json text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.properties text eol=lf

# Binary: never apply line-ending conversion
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.aar binary
*.apk binary
*.jks binary
*.keystore binary
