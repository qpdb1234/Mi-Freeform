*.iml
.gradle
/local.properties
/.idea/caches
/.idea/libraries
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties

# ---------- Ignore rules added when publishing to GitHub ----------
# Signing material: no keystore may enter the repository (the app still builds, because
# build.gradle falls back to debug signing automatically when the keystore is missing)
*.jks
*.keystore
keystore.properties

# Per-module build outputs: the /build above only covers the repository root; things like app/build need a separate match
build/

# IDE local state is never committed (upstream history once tracked .idea; here we untrack it and keep it out)
.idea/

# Throwaway local-debug leftovers: scripts/dirs starting with _, root-directory screenshots, dumps and logs
/_*
/*.png
*.log
*.out

# Built installers and source archives go through Releases, not the version history
*.apk
*.aab
*.7z
*.zip
