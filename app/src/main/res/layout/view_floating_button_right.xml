<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="@dimen/floating_button_width"
    android:layout_height="@dimen/floating_button_height">

    <!-- No outer margin: the handle capsule must fill the whole window, so that when the window touches the screen edge the visible part truly reaches the edge
         (in settings, X-axis position = 0 means flush to the edge; the old 4dp here always left it one body-width short). -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bar_corners_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>