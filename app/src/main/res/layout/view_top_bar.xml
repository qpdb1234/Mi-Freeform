<?xml version="1.0" encoding="utf-8"?>
<!--
  The top bar of the floating freeform window.

  Its structure mirrors Mi-Freeform's own bottom bar view_bar.xml:
  a ConstraintLayout + two Guidelines (33% / 67%) split the whole bar into three cells,
  each cell given 0dp width and stretched by constraints.

  ConstraintLayout is required here: with the earlier FrameLayout-based layout,
  layout_width="0dp" would resolve to a real 0-pixel width, the line in each of the three cells would never be drawn,
  and the top bar would show "nothing at all".

  Each of the three cells maps to one action, from left to right: close / full screen / collapse.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topBarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/color_background">

    <!-- Slot 1: close -->
    <LinearLayout
        android:id="@+id/topBarClose"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/topBarGuideline1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/top_bar_icon_size"
            android:layout_height="@dimen/top_bar_icon_size"
            android:src="@drawable/ic_top_bar_close"
            android:contentDescription="@string/top_bar_close" />
    </LinearLayout>

    <!-- Slot 2: full screen -->
    <LinearLayout
        android:id="@+id/topBarFullScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/topBarGuideline2"
        app:layout_constraintStart_toStartOf="@id/topBarGuideline1"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/top_bar_icon_size"
            android:layout_height="@dimen/top_bar_icon_size"
            android:src="@drawable/ic_top_bar_full_screen"
            android:contentDescription="@string/top_bar_full_screen" />
    </LinearLayout>

    <!-- Slot 3: collapse (minimize) -->
    <LinearLayout
        android:id="@+id/topBarMinimize"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/topBarGuideline2"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/top_bar_icon_size"
            android:layout_height="@dimen/top_bar_icon_size"
            android:src="@drawable/ic_top_bar_minimize"
            android:contentDescription="@string/top_bar_minimize" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topBarGuideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topBarGuideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.67" />

</androidx.constraintlayout.widget.ConstraintLayout>
