<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮小窗的顶栏。

  结构与 Mi-Freeform 自家底栏 view_bar.xml 保持一致：
  ConstraintLayout + 两条 Guideline（33% / 67%）把整条分成三格，
  每格用 0dp 宽度由约束撑开。

  这里必须用 ConstraintLayout：如果像之前的写法那样放进 FrameLayout，
  layout_width="0dp" 会得到真正的 0 像素宽度，三段里的横线永远画不出来，
  顶栏就成了「什么都没有」。

  三格各自对应一个操作，从左到右依次为：关闭 / 全屏 / 收起。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topBarRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/color_background">

    <!-- 第1位：关闭 -->
    <LinearLayout
        android:id="@+id/topBarClose"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/topBarGuideline1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/top_bar_icon_size"
            android:layout_height="@dimen/top_bar_icon_size"
            android:src="@drawable/ic_top_bar_close"
            android:contentDescription="@string/top_bar_close" />
    </LinearLayout>

    <!-- 第2位：全屏 -->
    <LinearLayout
        android:id="@+id/topBarFullScreen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/topBarGuideline2"
        app:layout_constraintStart_toStartOf="@id/topBarGuideline1"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/top_bar_icon_size"
            android:layout_height="@dimen/top_bar_icon_size"
            android:src="@drawable/ic_top_bar_full_screen"
            android:contentDescription="@string/top_bar_full_screen" />
    </LinearLayout>

    <!-- 第3位：收起（最小化） -->
    <LinearLayout
        android:id="@+id/topBarMinimize"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/topBarGuideline2"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="@dimen/top_bar_icon_size"
            android:layout_height="@dimen/top_bar_icon_size"
            android:src="@drawable/ic_top_bar_minimize"
            android:contentDescription="@string/top_bar_minimize" />
    </LinearLayout>

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topBarGuideline1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topBarGuideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.67" />

</androidx.constraintlayout.widget.ConstraintLayout>
