<?xml version="1.0" encoding="utf-8"?>
<!--
  The three status cards at the top of the settings page (Xposed / Shizuku / accessibility).
  They are inflated dynamically by SettingFragment in onCreateRecyclerView and inserted one by one.
  The height is computed from listPreferredItemHeight (matching the Preference rows below) + padding,
  so they line up visually with the settings rows.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_cards_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical" />
