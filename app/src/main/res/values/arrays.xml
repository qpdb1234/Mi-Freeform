<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="xposedscope">
        <item>android</item>
        <item>com.android.systemui</item>
        <item>com.motorola.launcher3</item>
        <item>com.android.launcher3</item>
        <item>com.google.android.apps.nexuslauncher</item>
    </string-array>

    <string-array name="floating_show_position">
        <item>Left side of screen</item>
        <item>Right side of screen</item>
    </string-array>

    <integer-array name="floating_show_position_value">
        <item>-1</item>
        <item>1</item>
    </integer-array>

    <!-- Selectable actions for the top-bar buttons; the order must match the id order of the TopBarAction enum -->
    <string-array name="top_bar_action">
        <item>Close</item>
        <item>Full screen</item>
        <item>Minimize</item>
        <item>Back</item>
        <item>Screenshot</item>
        <item>Rotate window</item>
        <item>Move to center</item>
        <item>None</item>
    </string-array>

    <integer-array name="top_bar_action_value">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
        <item>4</item>
        <item>5</item>
        <item>6</item>
        <item>7</item>
    </integer-array>

    <!-- Collapse mode: 0=sidebar, 1=floating ball. The order matches FreeformView.MINIMIZE_MODE_* -->
    <string-array name="minimize_mode">
        <item>Sidebar</item>
        <item>Floating ball</item>
    </string-array>

    <integer-array name="minimize_mode_value">
        <item>0</item>
        <item>1</item>
    </integer-array>

    <string-array name="service_type">
        <item>Accessibility service</item>
        <item>Foreground service</item>
    </string-array>

    <integer-array name="service_type_value">
        <item>0</item>
        <item>1</item>
    </integer-array>

    <!-- In-app language: 0=follow system, 1=Simplified Chinese, 2=English; must match LocaleHelper.LANGUAGE_*.
         "简体中文 / English" are conventionally written in their own language under every locale, so they are not translated -->
    <string-array name="app_language">
        <item>Follow system</item>
        <item>简体中文</item>
        <item>English</item>
    </string-array>

    <integer-array name="app_language_value">
        <item>0</item>
        <item>1</item>
        <item>2</item>
    </integer-array>

    <!-- Drag-to-scale mode: 0=proportional, 1=free. The order matches FreeformView.SCALE_MODE_* -->
    <string-array name="freeform_scale_mode">
        <item>Proportional</item>
        <item>Free</item>
    </string-array>

    <integer-array name="freeform_scale_mode_value">
        <item>0</item>
        <item>1</item>
    </integer-array>

    <array name="waveSideBarLetters">
        <item>A</item>
        <item>B</item>
        <item>C</item>
        <item>D</item>
        <item>E</item>
        <item>F</item>
        <item>G</item>
        <item>H</item>
        <item>I</item>
        <item>J</item>
        <item>K</item>
        <item>L</item>
        <item>M</item>
        <item>N</item>
        <item>O</item>
        <item>P</item>
        <item>Q</item>
        <item>R</item>
        <item>S</item>
        <item>T</item>
        <item>U</item>
        <item>V</item>
        <item>W</item>
        <item>X</item>
        <item>Y</item>
        <item>Z</item>
    </array>

</resources>
