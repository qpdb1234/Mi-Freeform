<?xml version="1.0" encoding="utf-8"?>
<resources>
    <attr name="popupColorTertiary" format="color" />

    <declare-styleable name="WaveSideBarView">
        <attr name="sidebarTextColor" format="color|reference"/>
        <attr name="sidebarBackgroundColor" format="color|reference"/>
        <attr name="sidebarChooseTextColor" format="color|reference"/>
        <attr name="sidebarTextSize" format="dimension"/>
        <attr name="sidebarLargeTextSize" format="dimension"/>
        <attr name="sidebarRadius" format="dimension"/>
        <attr name="sidebarBallRadius" format="dimension"/>
    </declare-styleable>

    <!-- Numeric input slider: only seekStep is declared (the drag step; on release the value snaps to a multiple of it).
         app:min / android:max are not re-declared here; they are read by the parent SeekBarPreference's own styleable,
         and this control uses the min / max attributes directly. We did not reuse the framework's android:seekBarIncrement,
         first because it fails AAPT in the compileSdk 32 xml, and second because it only affects the arrow keys and does not snap during dragging. -->
    <declare-styleable name="NumericSeekBarPreference">
        <attr name="seekStep" format="integer" />
    </declare-styleable>
</resources>