<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!--gradient fill-->
    <gradient
        android:angle="90"
        android:endColor="@android:color/transparent"
        android:startColor="@android:color/darker_gray"
        android:type="linear"
        android:useLevel="true" />
    <!--solid color fill-->
    <!--<solid android:color="#ffffff"/>-->
    <!--a 1:1 width-to-height ratio makes a quarter circle-->
    <size
        android:width="@dimen/hang_up_tip_size"
        android:height="@dimen/hang_up_tip_size" />
    <!--any one of the four corners, with a radius no smaller than the width/height value-->
    <corners
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp"
        android:topLeftRadius="0dp"
        android:topRightRadius="@dimen/hang_up_tip_size" />
</shape>