<?xml version="1.0" encoding="utf-8"?>
<!--
  App icon foreground (adaptive icon): themed on the "floating freeform" — a main window plus an
  overlay floating window that can be freely dragged/scaled. Viewport 108x108, the combined bounding box of the two windows is centered at (54,54).
  q261013
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Main window card (white, rounded corners) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M34,33h32a6,6 0 0 1 6,6v26a6,6 0 0 1 -6,6h-32a6,6 0 0 1 -6,-6v-26a6,6 0 0 1 6,-6z" />

    <!-- Three buttons on the main window's title bar (red/yellow/green) — instantly reads as a "window" -->
    <path android:fillColor="#FF5F57" android:pathData="M33,40a2,2 0 1 0 4,0a2,2 0 1 0 -4,0z" />
    <path android:fillColor="#FEBC2E" android:pathData="M40,40a2,2 0 1 0 4,0a2,2 0 1 0 -4,0z" />
    <path android:fillColor="#28C840" android:pathData="M47,40a2,2 0 1 0 4,0a2,2 0 1 0 -4,0z" />

    <!-- Floating window (light blue, white stroke), overlapping and poking out at the main window's bottom-right corner -->
    <path
        android:fillColor="#8FBBF0"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.5"
        android:pathData="M55,49h20a5,5 0 0 1 5,5v16a5,5 0 0 1 -5,5h-20a5,5 0 0 1 -5,-5v-16a5,5 0 0 1 5,-5z" />

    <!-- Title dot of the floating window -->
    <path android:fillColor="#2E4E86" android:pathData="M52.4,54a1.6,1.6 0 1 0 3.2,0a1.6,1.6 0 1 0 -3.2,0z" />

    <!-- The "resize handle" L-shape at the floating window's bottom-right corner: hugging the inner rounded corner, inset equally on both sides, vertex at (78,73) -->
    <path
        android:strokeColor="#2E4E86"
        android:strokeWidth="1.3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M74,73L78,73L78,69" />
</vector>
