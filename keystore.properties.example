# Template for local signing material: copy it to keystore.properties at the repository root and fill in your own values.
# Both keystore.properties and *.jks are already excluded in .gitignore, so the private key and passwords never enter the repository.
#
# storeFile is a path relative to the repository root.
storeFile=sunshinekey.jks
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-password

# Generate your own key (the DN is written into the APK; use your own name):
# keytool -genkeypair -keystore sunshinekey.jks -alias demo \
#   -keyalg RSA -keysize 2048 -validity 10000
