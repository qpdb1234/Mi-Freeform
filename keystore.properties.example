# 本地签名材料模板：复制成仓库根的 keystore.properties 后填自己的值。
# keystore.properties 与 *.jks 都已在 .gitignore 里排除，私钥和口令不会进仓库。
#
# storeFile 是相对仓库根目录的路径。
storeFile=sunshinekey.jks
storePassword=你的仓库口令
keyAlias=你的密钥别名
keyPassword=你的密钥口令

# 生成一份自己的密钥（DN 会写进 APK，建议用你自己的名字）：
# keytool -genkeypair -keystore sunshinekey.jks -alias demo \
#   -keyalg RSA -keysize 2048 -validity 10000
